@page "/Cocktails"
@inject IDialogService DialogService
@using BarBud.Models

@rendermode InteractiveServer
<MudCard Elevation="6" Class="mb-4 w-100 rounded-lg" Style="background: var(--mud-palette-primary); background: linear-gradient(135deg, var(--mud-palette-primary) 0%, var(--mud-palette-secondary) 100%); overflow: hidden; position: relative;">
	<div style="position: absolute; top: -30px; right: -30px; width: 150px; height: 150px; background: rgba(255,255,255,0.1); border-radius: 50%;"></div>
	<MudCardContent Class="d-flex align-center pa-6">
		<MudIcon Icon="@Icons.Material.Filled.LocalDrink" Size="Size.Large" Style="color: white; width: 48px; height: 48px;" Class="mr-4" />
		<div class="d-flex flex-column">
			<MudText Typo="Typo.h3" Style="color: white; font-weight: 900; letter-spacing: 1px; text-shadow: 1px 1px 3px rgba(0,0,0,0.2);">
				COCKTAILS
			</MudText>
			<MudText Typo="Typo.subtitle2" Style="color: rgba(255,255,255,0.85);">
				Explore and mix your favorite drinks, Don't forget to drink and drive it almost always ends well!
			</MudText>
		</div>
	</MudCardContent>
	</MudCard>
	<MudTextField @bind-Value="SearchString" Placeholder="Search cocktails..."
				  Adornment="Adornment.Start"
				  AdornmentIcon="@Icons.Material.Filled.Search"
				  Immediate="true"
				  Clearable="true"
			  Class="mb-2"></MudTextField>
<MudTable Items="@filteredCocktailsList"
	T="Cocktail"
	Hover="true"
	Style="table-layout: fixed; width: 100%;">
<ColGroup>
	<col style="width:30%" />
	<col style="width:50%" />
	<col style="width:20%" />
	<col style="width:10%" />
</ColGroup>
<HeaderContent>
	<MudTh>Name</MudTh>
	<MudTh>Description</MudTh>
	<MudTh>Recipe</MudTh>
	<MudTh> </MudTh>
</HeaderContent>

<RowTemplate>
        @{
            var cocktail = context;
        }
        <MudTd Style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap; cursor:pointer;"
               @onclick="() => OnRowClick(cocktail)">
            @cocktail.Name
        </MudTd>
        <MudTd Style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap; cursor:pointer;"
		   @onclick="() => OnRowClick(cocktail)">
		@cocktail.Description
        </MudTd>
        <MudTd Style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap; cursor:pointer;"
		   @onclick="() => OnRowClick(cocktail)">
		@cocktail.Recipe
        </MudTd>
        <MudTd Style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap; cursor:pointer;"
		   @onclick="() => OnRowClick(cocktail)">
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                            Color="Color.Error"
					   OnClick="async () => await DeleteCocktailAsync(cocktail.Id)" />
        </MudTd>
    </RowTemplate>

</MudTable>

<MudCard Outlined="true" elevation="2" class="mt-4" width="400px" height="250px" variant="outlined">
	<MudCardContent>
		<MudText>Add another Drink! You alcoholic!</MudText>
		<MudForm @ref="form">
			<MudTextField Label="Name" Required="true" @bind-Value="@newCocktail.Name" />
			<MudTextField Label="Description" @bind-Value="@newCocktail.Description" />
			<MudTextField Label="Recipe, (not sure what to put here)" @bind-Value="@newCocktail.Recipe" />
			<MudButton ButtonType="ButtonType.Submit"
					   Color="Color.Success"
					   OnClick="@(async() => await AddCocktailsAsync(newCocktail))">Submit</MudButton>
		</MudForm>
	</MudCardContent>
</MudCard>




@using MudBlazor.Examples.Data.Models

@page "/Ingredients"

<MudText>Ingredients</MudText>
<MudAlert>Coming soon!</MudAlert>

<MudTable Items="@IngredientList" Hover="true">
    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh>Description</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name">@IngredidentList.Name</MudTd>
        <MudTd DataLabel="Description">@IngredientList.Description</MudTd>
    </RowTemplate>
</MudTable>

<MudCard Outlined="true">
    <MudCardContent>
        <MudText>Add an Ingredient</MudText>

    </MudCardContent>
    <MudCardActions>
        <MudButton Material="@Icons.Material.Filled.PlusOne" Color="Color.Success">Add</MudButton>
    </MudCardActions>
</MudCard>






@page "/Ingredients"
@inject IDialogService DialogService
@using BarBud.Models

@rendermode InteractiveServer
<MudCard Elevation="6" Class="mb-4 w-100 rounded-lg" Style="background: var(--mud-palette-primary); background: linear-gradient(135deg, var(--mud-palette-primary) 0%, var(--mud-palette-secondary) 100%); overflow: hidden; position: relative;">
    <div style="position: absolute; top: -30px; right: -30px; width: 150px; height: 150px; background: rgba(255,255,255,0.1); border-radius: 50%;"></div>
    <MudCardContent Class="d-flex align-center pa-6">
        <MudIcon Icon="@Icons.Material.Filled.LocalBar" Size="Size.Large" Style="color: white; width: 48px; height: 48px;" Class="mr-4" />
        <div class="d-flex flex-column">
            <MudText Typo="Typo.h3" Style="color: white; font-weight: 900; letter-spacing: 1px; text-shadow: 1px 1px 3px rgba(0,0,0,0.2);">
                INGREDIENTS
            </MudText>
            <MudText Typo="Typo.subtitle2" Style="color: rgba(255,255,255,0.85);">
                Manage your inventory and recipes
            </MudText>
        </div>
    </MudCardContent>
</MudCard>
<MudTextField @bind-Value="SearchString" Placeholder="Search ingredients..."
              Adornment="Adornment.Start"
              AdornmentIcon="@Icons.Material.Filled.Search"
              Immediate="true"
              Clearable="true"
              Class="mb-2" ></MudTextField>

<MudTable Items="@filteredIngredientsList"
          T="Ingredient"
          Hover="true"
          Style="table-layout: fixed; width: 100%;">
    
    <ColGroup>
        <col style="width:30%" />
        <col style="width:50%" />
        <col style="width:20%" />
        <col style="width:10%" />
    </ColGroup>

    <HeaderContent >
        <MudTh>Name</MudTh>
        <MudTh>Description</MudTh>
        <MudTh>Amount</MudTh>
        <MudTh> </MudTh>
    </HeaderContent>

    <RowTemplate>
        @{
            var ingredient = context;
        }
        <MudTd Style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap; cursor:pointer;"
               @onclick="() => OnRowClick(ingredient)">
            @ingredient.Name
        </MudTd>
        <MudTd Style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap; cursor:pointer;"
               @onclick="() => OnRowClick(ingredient)">
            @ingredient.Description
        </MudTd>
        <MudTd Style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap; cursor:pointer;"
               @onclick="() => OnRowClick(ingredient)">
            @ingredient.Amount
        </MudTd>
        <MudTd Style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap; cursor:pointer;"
                @onclick="() => OnRowClick(ingredient)">
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                            Color="Color.Error"
                            OnClick="async () => await DeleteIngredientAsync(ingredient.Id)" />
        </MudTd>
    </RowTemplate>

</MudTable>

<MudCard Outlined="true" elevation="2" class="mt-4" width="400px" height="250px" variant="outlined">
    <MudCardContent>
        <MudText>Add an Ingredient</MudText>
        <MudForm @ref="form">
            <MudTextField Label="Name" Required="true" @bind-Value="@NewIngredient.Name" />
            <MudTextField Label="Description" @bind-Value="@NewIngredient.Description" />
            <MudTextField Label="Amount" @bind-Value="@NewIngredient.Amount" />
            <MudButton ButtonType="ButtonType.Submit"
                       Color="Color.Success"
                       OnClick="@(async() => await AddIngredientAsync(NewIngredient))">Submit</MudButton>
        </MudForm>
    </MudCardContent>
</MudCard>
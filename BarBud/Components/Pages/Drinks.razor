@page "/drinks"
@inject IDialogService DialogService
@using BarBud.Models
<MudPaper Class="pa-4" Elevation="3">
    <MudStack Spacing="3">

        <!-- Title & intro -->
        <MudStack Row="true"  JustifyContent="SpaceBetween">
            <MudText Typo="Typo.h4">
                Drinks
            </MudText>
            <MudText Typo="Typo.subtitle2" Class="text-secondary">
                Manage your BarBud drink collection
            </MudText>
        </MudStack>

        <!-- Add New Drink -->
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" GutterBottom="true">
                Add a new drink
            </MudText>

            <MudForm @ref="form">
                <MudGrid GutterSize="3">
                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="newDrink.Name"
                                      Label="Name"
                                      For="@(() => newDrink.Name)"
                                      Required="true"
                                      RequiredError="Name is required"
                                      Variant="Variant.Outlined"
                                      FullWidth="true" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudStack Row="true" Spacing="2" >
                            <MudButton Color="Color.Primary"
                                       Variant="Variant.Filled"
                                       ButtonType="ButtonType.Submit"
                                       OnClick="@(async() => await AddDrinkAsync(newDrink))">
                                Add Drink
                            </MudButton>

                            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                            {
                                <MudAlert Severity="Severity.Error" Dense="true">
                                    @ErrorMessage
                                </MudAlert>
                            }
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </MudForm>
        </MudPaper>

        <!-- Drink List -->
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" GutterBottom="true">
                Your drinks
            </MudText>

            <MudTable Items="_drinkList" Dense="true" Hover="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    @* Add more headers if you have more properties *@
                    @* <MudTh>Description</MudTh> *@
                    <MudTh class="text-right">Actions</MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd>
                        <MudTextField @bind-Value="context.Name"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      FullWidth="true"
                                      Immediate="true" />
                    </MudTd>

                    @* Example extra column:
                    <MudTd>
                        <MudTextField @bind-Value="context.Description"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      FullWidth="true"
                                      Immediate="true" />
                    </MudTd>
                    *@

                    <MudTd Class="text-right">
                        <MudIconButton Icon="@Icons.Material.Filled.Save"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       OnClick="@(()=>UpdateDrinkAsync(context))"
                                       Title="Save changes" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(()=>DeleteDrinkAsync(context.Id))"
                                       Title="Delete drink" />
                    </MudTd>
                </RowTemplate>

                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Class="pa-4">
                        No drinks yet. Add your first one above!
                    </MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>

    </MudStack>
</MudPaper>



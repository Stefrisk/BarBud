@page "/drinks"
@using BarBud.Models

<MudPaper Class="pa-4" Elevation="3">
    <MudStack Spacing="3">

        <!-- Title & intro -->
        <MudStack Row="true" JustifyContent="SpaceBetween">
            <MudText Typo="Typo.h4">
                Drinks
            </MudText>
            <MudText Typo="Typo.subtitle2" Class="text-secondary">
                Manage your BarBud drink collection
            </MudText>
        </MudStack>

        <!-- Add New Drink -->
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" GutterBottom="true">
                Add a new drink
            </MudText>

            <MudForm @ref="form"
                     OnValidSubmit="AddDrinkAsync"
                     OnInvalidSubmit="OnInvalidSubmit">
                <MudStack Spacing="3">
                    <!-- Drink Name -->
                    <MudTextField @bind-Value="newDrinkName"
                                  Label="Drink Name"
                                  For="@(() => newDrinkName)"
                                  Required="true"
                                  RequiredError="Name is required"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />

                    <!-- Create Recipe Toggle -->
                    <MudSwitch @bind-Value="createRecipe"
                               Color="Color.Primary"
                               Label="Create recipe with this drink" />
                              

                    <!-- Recipe Section (shown when toggle is enabled) -->
                    @if (createRecipe)
                    {
                        <MudPaper Class="pa-3" Outlined="true">
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.subtitle1" Color="Color.Primary">Recipe Details</MudText>

                                <!-- Recipe Name -->
                                <MudTextField @bind-Value="recipeName"
                                              Label="Recipe Name"
                                              Required="true"
                                              RequiredError="Recipe name is required"
                                              Variant="Variant.Outlined"
                                              FullWidth="true" />

                                <!-- Ingredients List -->
                                <MudText Typo="Typo.subtitle2">Ingredients</MudText>
                                
                                @foreach (var ingredient in recipeIngredients)
                                {
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" sm="5">
                                            <MudSelect @bind-Value="ingredient.IngredientId"
                                                       Label="Ingredient"
                                                       Variant="Variant.Outlined"
                                                       Required="true"
                                                       T="int?"
                                                       AnchorOrigin="Origin.BottomCenter">
                                                @foreach (var item in availableIngredients)
                                                {
                                                    <MudSelectItem Value="@((int?)item.Id)">@item.Name</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12" sm="3">
                                            <MudNumericField @bind-Value="ingredient.Quantity"
                                                           Label="Quantity"
                                                           Variant="Variant.Outlined"
                                                           Min="0m"
                                                           Step="0.25m"
                                                           T="decimal" />
                                        </MudItem>
                                        <MudItem xs="12" sm="3">
                                            <MudTextField @bind-Value="ingredient.Unit"
                                                         Label="Unit"
                                                         Variant="Variant.Outlined"
                                                         Placeholder="oz, ml, dash..." />
                                        </MudItem>
                                        <MudItem xs="12" sm="1">
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                         Color="Color.Error"
                                                         OnClick="@(() => RemoveIngredientRow(ingredient))"
                                                         Disabled="@(recipeIngredients.Count == 1)"
                                                         Title="Remove ingredient" />
                                        </MudItem>
                                    </MudGrid>
                                }

                                <MudButton Variant="Variant.Outlined"
                                          Color="Color.Primary"
                                          StartIcon="@Icons.Material.Filled.Add"
                                          OnClick="AddIngredientRow"
                                          Size="Size.Small">
                                    Add Ingredient
                                </MudButton>

                                <!-- Instructions -->
                                <MudTextField @bind-Value="recipeInstructions"
                                              Label="Instructions"
                                              Variant="Variant.Outlined"
                                              Lines="4"
                                              FullWidth="true"
                                              Placeholder="Describe how to prepare this drink..." />
                            </MudStack>
                        </MudPaper>
                    }

                    <!-- Feedback Messages -->
                    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                    {
                        <MudAlert Severity="Severity.Error" Dense="true">
                            @ErrorMessage
                        </MudAlert>
                    }

                    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
                    {
                        <MudAlert Severity="Severity.Success" Dense="true">
                            @SuccessMessage
                        </MudAlert>
                    }

                    <!-- Submit Button -->
                    <MudButton Color="Color.Primary"
                               Variant="Variant.Filled"
                               ButtonType="ButtonType.Submit"
                               FullWidth="false">
                        @(createRecipe ? "Add Drink with Recipe" : "Add Drink")
                    </MudButton>
                </MudStack>
            </MudForm>
        </MudPaper>

        <!-- Drink List -->
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" GutterBottom="true">
                Your drinks
            </MudText>

            <MudTable Items="_drinkList" Dense="true" Hover="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Details</MudTh>
                    <MudTh class="text-right">Actions</MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd>
                        <MudTextField @bind-Value="context.Name"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      FullWidth="true"
                                      Immediate="true" />
                    </MudTd>
                    <MudTd>
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Primary"
                                   Href="@($"/drinks/{context.Id}")">
                            View
                        </MudButton>
                    </MudTd>

                    <MudTd Class="text-right">
                        <MudIconButton Icon="@Icons.Material.Filled.Save"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       OnClick="@(()=>UpdateDrinkAsync(context))"
                                       Title="Save changes" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(()=>DeleteDrinkAsync(context.Id))"
                                       Title="Delete drink" />
                    </MudTd>
                </RowTemplate>

                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Class="pa-4">
                        No drinks yet. Add your first one above!
                    </MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>

    </MudStack>
</MudPaper>


